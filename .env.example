MEET_URL_01=https://meet.google.com/xxx-xxxx-xxx

# --- LLM Backend ---
# Bundled Ollama (default): run with `docker compose --profile local-llm up`
# External LLM:            set these vars and run `docker compose up` (Ollama container won't start)
# LLM_URL=http://ollama:11434/api/chat
# LLM_MODEL=qwen2.5:3b

# --- Speech Recognition (WhisperX) ---
# WHISPER_MODEL=base                  # Whisper model: tiny, base, small, medium, large-v3
# WHISPER_LANG=                       # Force language (e.g., pt, en). Empty = auto-detect.
# WHISPER_DEVICE=                     # Force device: cuda, cpu. Empty = auto-detect.
# WHISPER_COMPUTE=                    # Compute type: float16, int8, float32. Empty = auto per device.

# --- Speaker Diarization ---
# HF_TOKEN=hf_xxxxx                  # HuggingFace token for pyannote speaker diarization.
#                                     # Required: accept agreements at huggingface.co/pyannote/speaker-diarization
#                                     # and huggingface.co/pyannote/segmentation. If unset, diarization is disabled.

# --- noVNC Debugging ---
# NOVNC_ENABLED=1    # Set to 1 to enable noVNC on port 680<node_id> (e.g. 6801 for node01)
