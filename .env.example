MEET_URL_01=https://meet.google.com/xxx-xxxx-xxx

# --- LLM Backend ---
# Bundled Ollama (default): run with `docker compose --profile local-llm up`
# External LLM:            set these vars and run `docker compose up` (Ollama container won't start)
# LLM_URL=http://ollama:11434/api/chat
# LLM_MODEL=qwen2.5:3b

# --- Speech Recognition (WhisperX) ---
# WHISPER_MODEL=base                  # Whisper model: tiny, base, small, medium, large-v3
# WHISPER_LANG=                       # Force language (e.g., pt, en). Empty = auto-detect.
# WHISPER_DEVICE=                     # Force device: cuda, cpu. Empty = auto-detect.
# WHISPER_COMPUTE=                    # Compute type: float16, int8, float32. Empty = auto per device.

# --- Speech Output ---
# TTS_LANG=                          # Force TTS language (e.g., pt). Empty = language Whisper detected.

# --- Speaker Identification ---
# HF_TOKEN=hf_xxxxx                  # HuggingFace token; enables voice identification by default.
# SPEAKER_ID=                        # 1/0 to force voice identification on/off.
# SPEAKER_THRESHOLD=0.6              # Minimum cosine similarity for a voice match.

# --- Conversation ---
# HISTORY_TURNS=6                    # Exchanges remembered per node.
# HISTORY_TTL=300                    # Seconds of silence before the history is forgotten.
# MAX_COMMAND_SECONDS=15             # Longest command recorded after the wake word.
# COMMAND_START_TIMEOUT=3            # Seconds to wait for speech after the wake word.
# VAD_MODE=2                         # WebRTC VAD aggressiveness 0-3 (3 drops normal speech).

# --- Cortex API ---
# CORTEX_BIND=127.0.0.1              # Host interface for port 5000 (/inject has no auth). 0.0.0.0 = LAN.

# --- noVNC Debugging ---
# noVNC: generate the compose with `python scripts/generate_deployment.py --novnc` (localhost:680<node_id>)
